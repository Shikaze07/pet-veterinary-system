generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}
enum Role {
  ADMIN
  VET
  OWNER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum InvoiceStatus {
  UNPAID
  PAID
}

model User {
  id        String   @id @default(uuid())
  firstName      String
  middleName      String?
  lastName      String
  email     String   @unique
  password  String
  phone     String?
  address   String?
  role      Role     @default(OWNER)
  createdAt DateTime @default(now())

  pets          Pet[]
  invoices      Invoice[]
  appointments  Appointment[]
}

model Pet {
  id        String   @id @default(uuid())
  name      String
  species   String
  breed     String?
  gender    String?
  age       Float?
  weight    Float?
  color     String?

  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id])

  consultations Consultation[]
  vaccinations  Vaccination[]
  invoices      Invoice[]   
  appointments  Appointment[]
}

model Consultation {
  id          String   @id @default(uuid())
  petId       String
  date        DateTime @default(now())
  symptoms    String
  diagnosis   String
  treatment   String
  cost        Float

  pet         Pet      @relation(fields: [petId], references: [id])
}

model Vaccination {
  id          String   @id @default(uuid())
  petId       String
  vaccineName String
  dateGiven   DateTime
  nextDue     DateTime?
  notes       String?

  pet         Pet      @relation(fields: [petId], references: [id])
}

model Medication {
  id           String  @id @default(uuid())
  name         String
  brand        String?
  category     String?
  stock        Int
  minStock     Int
  price        Float
}

model Appointment {
  id        String             @id @default(uuid())
  ownerId   String
  petId     String
  date      DateTime
  reason    String
  status    AppointmentStatus @default(PENDING)
  notes     String?

  owner     User   @relation(fields: [ownerId], references: [id])
  pet       Pet    @relation(fields: [petId], references: [id])
}

model Invoice {
  id          String        @id @default(uuid())
  ownerId     String
  petId       String?
  totalAmount Float
  dueDate     DateTime
  status      InvoiceStatus @default(UNPAID)

  owner       User          @relation(fields: [ownerId], references: [id])
  pet         Pet?          @relation(fields: [petId], references: [id])

  items       InvoiceItem[]
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  quantity    Int
  price       Float
  total       Float

  invoice     Invoice @relation(fields: [invoiceId], references: [id])
}