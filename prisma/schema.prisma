generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}
enum Role {
  ADMIN
  VET
  OWNER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum CostingCategory {
  CONSULTATION
  MEDICATION
  VACCINATION
  OTHER
}

model User {
  id        String   @id @default(uuid())
  firstName      String
  middleName      String?
  lastName      String
  email     String   @unique
  password  String
  phone     String?
  address   String?
  role      Role     @default(OWNER)
  createdAt DateTime @default(now())

  pets          Pet[]
  costings      Costing[]
  appointments  Appointment[]
}

model Pet {
  id        String   @id @default(uuid())
  name      String
  species   String
  breed     String?
  gender    String?
  age       Float?
  weight    Float?
  color     String?

  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id])

  consultations Consultation[]
  vaccinations  Vaccination[]
  costings      Costing[]
  appointments  Appointment[]
}

model Consultation {
  id          String   @id @default(uuid())
  petId       String
  date        DateTime @default(now())
  symptoms    String
  diagnosis   String
  treatment   String

  pet         Pet      @relation(fields: [petId], references: [id])
}

model Vaccination {
  id          String   @id @default(uuid())
  petId       String
  vaccineName String
  dateGiven   DateTime
  nextDue     DateTime?
  notes       String?

  pet         Pet      @relation(fields: [petId], references: [id])
}

model Medication {
  id           String        @id @default(uuid())
  name         String
  brand        String?
  category     String?
  stock        Int
  minStock     Int
  price        Float

  costingItems CostingItem[]
}

model Appointment {
  id        String             @id @default(uuid())
  ownerId   String
  petId     String
  date      DateTime
  reason    String
  status    AppointmentStatus @default(PENDING)
  notes     String?

  owner     User   @relation(fields: [ownerId], references: [id])
  pet       Pet    @relation(fields: [petId], references: [id])
}

model Costing {
  id          String        @id @default(uuid())
  ownerId     String
  petId       String?
  date        DateTime      @default(now())
  notes       String?
  totalAmount Float

  owner       User          @relation(fields: [ownerId], references: [id])
  pet         Pet?          @relation(fields: [petId], references: [id])

  items       CostingItem[]
}

model CostingItem {
  id           String          @id @default(uuid())
  costingId    String
  medicationId String?
  category     CostingCategory
  description  String
  quantity     Int             @default(1)
  price        Float
  total        Float

  costing      Costing         @relation(fields: [costingId], references: [id], onDelete: Cascade)
  medication   Medication?     @relation(fields: [medicationId], references: [id], onDelete: SetNull)
}